{
  "name": "tech-mentorship-backend",
  "version": "1.0.0",
  "description": "Tech Mentorship Platform Backend - Full Stack Production",
  "main": "src/index.ts",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": ".\\.\\node_modules\\.bin\\prisma migrate dev",
    "generate": ".\\.\\node_modules\\.bin\\prisma generate",
    "studio": ".\\.\\node_modules\\.bin\\prisma studio",
    "db:push": ".\\.\\node_modules\\.bin\\prisma db push",
    "test": "jest",
    "seed": "ts-node --project prisma/tsconfig.json prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "mentorship",
    "mlops",
    "tech",
    "career",
    "fullstack"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "groq-sdk": "^1.1.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "prisma": "^5.22.0",
    "resend": "^6.12.2",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
