generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Mentor {
  id           String   @id @default(uuid()) @db.VarChar(36)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  name         String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  mentees      Mentee[]
}

model Mentee {
  id              String    @id @default(uuid()) @db.VarChar(36)
  name            String    @db.VarChar(255)
  email           String    @unique @db.VarChar(255)
  accessCode      String    @unique @db.VarChar(50)
  domainTrack     String    @db.VarChar(100)
  statedGoal      String?   @db.Text
  goalDomain      String?   @db.VarChar(100)
  alignmentStatus String?   @db.VarChar(20)
  topMatch        String?   @db.VarChar(100)
  secondMatch     String?   @db.VarChar(100)
  allScores       Json?
  mentorNote      String?   @db.Text
  startDate       DateTime  @default(now())
  isActive        Boolean   @default(true)
  onboardedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  mentorId        String?   @db.VarChar(36)
  mentor          Mentor?   @relation(fields: [mentorId], references: [id])
  submissions     WeeklySubmission[]
  emailLogs       EmailLog[]
}

model WeeklySubmission {
  id             String    @id @default(uuid()) @db.VarChar(36)
  menteeId       String    @db.VarChar(36)
  weekNumber     Int
  summary        String    @db.Text
  workDone       String    @db.Text
  link           String?   @db.VarChar(500)
  mentorFeedback String?   @db.Text
  feedbackAt     DateTime?
  submittedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  mentee         Mentee    @relation(fields: [menteeId], references: [id], onDelete: Cascade)

  @@unique([menteeId, weekNumber])
}

model AssessmentSession {
  id           String   @id @default(uuid()) @db.VarChar(36)
  sessionToken String   @unique @db.VarChar(36)
  name         String?  @db.VarChar(255)
  email        String?  @db.VarChar(255)
  statedGoal   String?  @db.Text
  answers      Json?
  completed    Boolean  @default(false)
  menteeId     String?  @db.VarChar(36)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model EmailLog {
  id         String    @id @default(uuid()) @db.VarChar(36)
  menteeId   String?   @db.VarChar(36)
  emailType  String    @db.VarChar(100)
  recipient  String    @db.VarChar(255)
  subject    String    @db.VarChar(500)
  status     String    @default("queued") @db.VarChar(50)
  providerId String?   @db.VarChar(255)
  errorMsg   String?   @db.Text
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  mentee     Mentee?   @relation(fields: [menteeId], references: [id])
}