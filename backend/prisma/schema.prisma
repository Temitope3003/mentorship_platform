generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model Mentee {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  accessCode      String   @unique @map("access_code")
  domainTrack     String   @map("domain_track")
  statedGoal      String?  @map("stated_goal")
  goalDomain      String?  @map("goal_domain")
  alignmentStatus String?  @map("alignment_status")
  topMatch        String?  @map("top_match")
  secondMatch     String?  @map("second_match")
  allScores       Json?    @map("all_scores")
  mentorNote      String?  @map("mentor_note")
  startDate       DateTime @default(now()) @map("start_date")
  isActive        Boolean  @default(true) @map("is_active")
  onboardedAt     DateTime? @map("onboarded_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  submissions WeeklySubmission[]
  emailLogs   EmailLog[]
}

model WeeklySubmission {
  id             String   @id @default(uuid())
  menteeId       String
  weekNumber     Int
  summary        String
  workDone       String   @map("work_done")
  link           String?
  mentorFeedback String?  @map("mentor_feedback")
  feedbackAt     DateTime? @map("feedback_at")
  submittedAt    DateTime @default(now()) @map("submitted_at")
  updatedAt      DateTime @updatedAt

  mentee Mentee @relation(fields: [menteeId], references: [id], onDelete: Cascade)

  @@unique([menteeId, weekNumber])
  @@map("weekly_submissions")
}

model EmailLog {
  id           String   @id @default(uuid())
  menteeId     String?
  emailType    String
  recipient    String
  subject      String
  status       String   @default("queued")
  providerId   String?  @map("provider_id")
  errorMessage String?  @map("error_message")
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime @default(now())

  mentee Mentee? @relation(fields: [menteeId], references: [id])
}

model AssessmentSession {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  name         String?
  email        String?
  statedGoal   String?  @map("stated_goal")
  answers      Json?
  completed    Boolean  @default(false)
  menteeId     String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  mentee Mentee? @relation(fields: [menteeId], references: [id])
}

model MentorAccount {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now())
}