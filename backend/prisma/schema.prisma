generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mentor {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  mentees      Mentee[]
}

model Mentee {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  accessCode      String    @unique
  domainTrack     String
  statedGoal      String?
  goalDomain      String?
  alignmentStatus String?
  topMatch        String?
  secondMatch     String?
  allScores       Json?
  mentorNote      String?
  startDate       DateTime  @default(now())
  isActive        Boolean   @default(true)
  onboardedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  mentorId        String?
  mentor          Mentor?   @relation(fields: [mentorId], references: [id])
  submissions     WeeklySubmission[]
  emailLogs       EmailLog[]
  liaisonOfficerId String?
  liaisonOfficer   LiaisonOfficer? @relation(fields: [liaisonOfficerId], references: [id])
  liaisonNotes String?
}

model WeeklySubmission {
  id             String    @id @default(uuid())
  menteeId       String
  weekNumber     Int
  summary        String
  workDone       String
  link           String?
  mentorFeedback String?
  feedbackAt     DateTime?
  submittedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  mentee         Mentee    @relation(fields: [menteeId], references: [id], onDelete: Cascade)

  @@unique([menteeId, weekNumber])
}

model AssessmentSession {
  id           String   @id @default(uuid())
  sessionToken String   @unique @default(uuid())
  name         String?
  email        String?
  statedGoal   String?
  answers      Json?
  completed    Boolean  @default(false)
  menteeId     String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model EmailLog {
  id         String    @id @default(uuid())
  menteeId   String?
  emailType  String
  recipient  String
  subject    String
  status     String    @default("queued")
  providerId String?
  errorMsg   String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  mentee     Mentee?   @relation(fields: [menteeId], references: [id])
}

model LiaisonOfficer {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  mentees      Mentee[]
}